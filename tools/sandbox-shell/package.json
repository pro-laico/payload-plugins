{
  "name": "@pro-laico/sandbox-shell",
  "version": "0.2.0",
  "private": true,
  "description": "Shared frontend shell for the example sandboxes: layout, theme, and the uniform seeding panel. Never published.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./cache": {
      "import": "./src/cache.ts",
      "types": "./src/cache.ts",
      "default": "./src/cache.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@pro-laico/payload-seed": "workspace:*",
    "next": ">=15.0.0",
    "payload": "^3.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@pro-laico/payload-seed": "workspace:*",
    "next": "^16.2.10",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "payload": "^3.86.0",
    "react": "^19.2.7",
    "typescript": "^6.0.3"
  }
}
